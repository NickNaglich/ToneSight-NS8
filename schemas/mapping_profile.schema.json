{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tonesight.local/schemas/mapping_profile.schema.json",
  "title": "ToneSight Mapping Profile",
  "type": "object",
  "required": [
    "schema",
    "name",
    "version",
    "n",
    "channels",
    "compose",
    "validation"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "const": "ns8.mapping.profile.v1"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^v[0-9]+$"
    },
    "n": {
      "type": "integer",
      "const": 8
    },
    "channels": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "required",
          "range"
        ],
        "additionalProperties": false,
        "properties": {
          "required": {
            "type": "boolean"
          },
          "range": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "prefixItems": [
              {
                "type": "integer",
                "const": 1
              },
              {
                "type": "integer",
                "const": 8
              }
            ]
          }
        }
      }
    },
    "compose": {
      "type": "object",
      "required": [
        "mode",
        "channel_order"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "const": "multi_channel_fold"
        },
        "channel_order": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "required": [
        "reject_on_out_of_range",
        "missing_channel_policy"
      ],
      "additionalProperties": false,
      "properties": {
        "reject_on_out_of_range": {
          "type": "boolean",
          "const": true
        },
        "missing_channel_policy": {
          "type": "string",
          "enum": [
            "error",
            "quarantine"
          ]
        }
      }
    }
  }
}
